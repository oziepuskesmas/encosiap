{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "ENCO"
   },
   "background": {
      "service_worker": "src/background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "src/interceptor.js" ],
      "matches": [ "https://sehatindonesiaku.kemkes.go.id/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "src/interceptor-relay.js" ],
      "matches": [ "https://sehatindonesiaku.kemkes.go.id/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "ENCO - Aplikasi Entry CKG Otomatis yang dibuat oleh Mochamad Fauzie, S.Gz",
   "host_permissions": [
      "https://ckgbankot.web.id/*",
      "https://sehatindonesiaku.kemkes.go.id/*",
      "https://form.kemkes.go.id/*",
      "https://1.1.1.1/*",
      "https://dns.google/*",
      "https://www.google.com/*",
      "https://ipwho.is/*",
      "https://api.ipify.org/*",
      "https://api.relayrouter.ai/*",
      "https://generativelanguage.googleapis.com/*"
   ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ENCO",
   "permissions": [ "activeTab", "storage", "scripting", "tabs", "identity", "alarms", "debugger", "proxy", "sidePanel" ],
   "side_panel": {
      "default_path": "popup.html?panel=true"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.0",
   "web_accessible_resources": [
      {
         "resources": [ "TEMPLATE BOT CKG.xlsx", "TEMPLATE BOT CKG SEKOLAH.xlsx", "template/*" ],
         "matches": [ "<all_urls>" ]
      }
   ]
}